; Engine configuration file.
; Compatible with Godot 4.x (all minor versions)

config_version=5

[application]

config/name="Hanuman Chronicles"
config/description="Valmiki Ramayana - 2D Action Adventure. Play as Hanuman."
config/version="1.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.0", "Forward Plus")
config/icon="res://assets/icon.png"

[autoload]

GameManager="*res://scripts/global/GameManager.gd"
SaveSystem="*res://scripts/global/SaveSystem.gd"
CheatCodes="*res://scripts/global/CheatCodes.gd"
AudioManager="*res://scripts/global/AudioManager.gd"
DialogueManager="*res://scripts/global/DialogueManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

